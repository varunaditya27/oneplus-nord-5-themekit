<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Atelier" parent="android:style/Theme.Material.NoActionBar">
        <!-- Keep ATELIER's launch scene genuinely black, independently of the OEM wallpaper.
             The app draws its own procedural atmosphere; the separately installed
             live wallpaper remains usable outside the launcher. -->
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">#080809</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#080809</item>
        <item name="android:navigationBarColor">#080809</item>
    </style>
</resources>
