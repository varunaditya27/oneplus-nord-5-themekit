{
  "schema": "atelier.motion.v1",
  "philosophy": "Respond to intent. Never decorate idle.",
  "durationsMs": {
    "pressSnap": 100,
    "state": 180,
    "selection": 150,
    "page": 220,
    "clockDraw": 560
  },
  "press": {
    "downScale": 0.955,
    "releaseDamping": "no-bounce",
    "durationType": "interruptible-spring"
  },
  "travelPx": {
    "page": 12,
    "searchResult": 8
  },
  "accent": "#CDA664",
  "policy": {
    "preferTransformOpacity": true,
    "reducedMotionDisablesSpatialMotion": true,
    "noPerpetualIconAnimations": true,
    "wallpaperPauseWhenHidden": true
  }
}
